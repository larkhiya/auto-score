# Copy to .env (or run `npm run init-env`, which generates the test-only values for you).
# .env is git-ignored. Never commit real keys.

# ---------- n8n ----------
N8N_BASE_URL=http://localhost:5678
# Encrypts credentials stored in n8n. Generated by init-env; keep it stable or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=
# LEARNER: create in the n8n editor (Settings > n8n API) and paste here.
N8N_API_KEY=
GENERIC_TIMEZONE=Etc/UTC

# ---------- Mock CRM (test-only secrets, generated by init-env) ----------
CRM_PORT=3000
# From the host (scripts). Inside Docker Compose, n8n uses http://crm:3000
CRM_BASE_URL=http://localhost:3000
CRM_API_KEY=
# Shared secret the CRM sends in the x-webhook-secret header; WF-01 rejects requests without it.
CRM_WEBHOOK_SECRET=
# Where the CRM sends webhooks (Compose service name, not localhost)
CRM_WEBHOOK_URL_APPLICATION=http://n8n:5678/webhook/application-received
CRM_WEBHOOK_URL_JOB=http://n8n:5678/webhook/job-draft-requested
# Failure simulation (Phase 6)
FAIL_RATE=0
LATENCY_MS=0

# ---------- Email intake (D-011: local GreenMail first, Gmail later) ----------
MAIL_IMAP_HOST=greenmail
MAIL_IMAP_PORT=3143
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=3025
# Test mailbox; plus-addressing routes to a job, e.g. applications+csr@autoscore.test
MAIL_USER=applications@autoscore.test
MAIL_PASSWORD=

# ---------- LLM (D-007: Gemini free tier for now) ----------
# LEARNER: create in Google AI Studio, paste here, and also enter it in the n8n "Google Gemini" credential yourself.
GEMINI_API_KEY=
GEMINI_MODEL=
# LLM proxy (D-031): host scripts use this to arm faults; generated by init-env (test-only).
LLM_PROXY_BASE_URL=http://localhost:8090
LLM_PROXY_ADMIN_KEY=
