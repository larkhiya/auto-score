{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-score.local/contracts/crm_update.schema.json",
  "title": "CrmUpdate",
  "description": "The body WF-10 PATCHes to the CRM. Every outcome (scored, rejected, review, error) uses this one shape, so the CRM always knows which rubric, prompt and model produced a result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_id",
    "status",
    "total_score",
    "breakdown",
    "summary",
    "reason_codes",
    "flags",
    "job_id",
    "job_profile_version",
    "prompt_version",
    "model",
    "execution_id",
    "processed_at",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "application_id": {
      "$ref": "common.schema.json#/$defs/application_id"
    },
    "status": {
      "enum": [
        "SCREENING",
        "PREFILTER_REJECTED",
        "SHORTLISTED",
        "MAYBE",
        "NOT_A_FIT",
        "NEEDS_REVIEW",
        "ERROR"
      ]
    },
    "total_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "breakdown": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "name",
              "weight",
              "score",
              "points",
              "evidence_quote",
              "evidence_verified",
              "rationale"
            ],
            "properties": {
              "criterion_id": {
                "$ref": "common.schema.json#/$defs/criterion_id"
              },
              "name": {
                "type": "string"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4,
                "description": "After the evidence check (an unverified quote zeroes the score)."
              },
              "points": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "weight × score / 4"
              },
              "evidence_quote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_verified": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/code"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/code"
      }
    },
    "job_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/job_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_profile_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "processed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    }
  },
  "allOf": [
    {
      "description": "A scored status must say what scored it.",
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SHORTLISTED",
              "MAYBE",
              "NOT_A_FIT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "total_score": {
            "type": "number"
          },
          "breakdown": {
            "type": "array",
            "minItems": 1
          },
          "job_id": {
            "$ref": "common.schema.json#/$defs/job_id"
          },
          "job_profile_version": {
            "type": "integer"
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "description": "Non-scored outcomes must say why.",
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PREFILTER_REJECTED",
              "NEEDS_REVIEW",
              "ERROR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
