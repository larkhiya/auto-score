{
  "name": "auto-score",
  "version": "0.1.0",
  "private": true,
  "description": "n8n + AI applicant screening: Boolean pre-filter, LLM rubric scoring against versioned job profiles, CRM write-back.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "init-env": "node scripts/init-env.js",
    "n8n:export": "node scripts/n8n-export.js",
    "n8n:import": "node scripts/n8n-import.js",
    "n8n:roundtrip": "node scripts/n8n-roundtrip-check.js",
    "build": "node scripts/build-validators.js && node scripts/build-prompts.js && node scripts/build-workflows.js",
    "build:check": "node scripts/build-validators.js --check && node scripts/build-prompts.js --check && node scripts/build-workflows.js --check",
    "fixtures": "node scripts/make-fixtures.js",
    "crm": "node --disable-warning=ExperimentalWarning crm/server.js",
    "n8n:drift": "node scripts/n8n-drift.js",
    "replay": "node scripts/replay-dlq.js",
    "chaos": "node scripts/chaos-run.js",
    "setup:dlq": "node scripts/n8n-setup-dlq.js",
    "check:injection": "node scripts/injection-check.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "docx": "^9.12.0",
    "jszip": "^3.10.2",
    "nodemailer": "^10.1.2",
    "pdf-lib": "^1.17.1"
  }
}
