      "name": "Email outcomes",
      "parameters": {
        "jsCode": "// Records in = records out: one line per email, success or failure.\nconst items = $input.all();\nconst outcomes = items.map((it) => (it.json.error\n  ? { status: 'FAILED', error: String(it.json.error.message || it.json.error).slice(0, 300) }\n  : { status: it.json.outcome || 'UNKNOWN', application_id: it.json.application_id || null }));\nreturn [{ json: { emails: items.length, failed: outcomes.filter((o) => o.status === 'FAILED').length, outcomes } }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        480,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
